[TEMPLATE]
# Mikrotik Watch - Configurações de Ambiente
# Copie este arquivo para .env e ajuste conforme necessário

# Aplicação
APP_NAME="Mikrotik Watch"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
APP_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET

# Banco de Dados - PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME="mikrotik_watch_db"
DB_USER="mikrotik_watch"
DB_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# Timezone
APP_TIMEZONE=America/Sao_Paulo

# Chave de criptografia reversível das senhas Mikrotik (sodium_crypto_secretbox).
# Gere com: php -r "echo base64_encode(random_bytes(32));"
# NUNCA exponha esta chave. NUNCA armazene no banco de dados.
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_TO_BASE64_ENCODED_32_BYTES

# Mikrotik API REST (porta 80/443 — NUNCA use a porta 8728)
MIKROTIK_DEFAULT_PORT=443
MIKROTIK_DEFAULT_USE_SSL=true
MIKROTIK_DEFAULT_VERIFY_SSL=true
MIKROTIK_DEFAULT_API_USER=admin
MIKROTIK_DEFAULT_API_TIMEOUT=5

# Permitir certificados self-signed em desenvolvimento (NÃO use em produção)
MIKROTIK_ALLOW_SELF_SIGNED=false

# Autenticação do painel
SESSION_TIMEOUT=3600

# Intervalo de coleta do cron (em minutos)
COLLECT_INTERVAL=5
